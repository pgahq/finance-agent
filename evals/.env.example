# Copy to evals/.env.local (gitignored). Non-secret IDs copied from the deployed Lambda configuration, so the replay builds
# the same Workday payload production would. Keep secrets out of this file.
FALLBACK_FUND_ID=
FALLBACK_COST_CENTER_ID=
FALLBACK_SPEND_CATEGORY_ID=
FALLBACK_LOB_ID=
FALLBACK_PAYMENT_TERMS_ID=
WORKDAY_DEFAULT_SUPPLIER_WID=
# Only if the deployment sets them:
# WORKDAY_DEFAULT_COMPANY_WID=
# WORKDAY_DEFAULT_COMPANY_NAME=
# OCR_MODEL=

# Connection (see evals/README.md): the SSM tunnel listens on localhost.
# AWS_PROFILE=finance-agent-eval
# DATABASE_SECRET_ARN=
# DATABASE_CLUSTER_ENDPOINT=localhost
# DATABASE_PORT=15432
# S3_BUCKET_NAME=finance-agent-<account id>
# AI_GATEWAY_API_KEY=
